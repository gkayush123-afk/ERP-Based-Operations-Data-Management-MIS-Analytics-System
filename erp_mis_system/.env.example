SECRET_KEY=generate-a-long-random-secret-before-running
DATABASE_URL=mysql+pymysql://erp_mis_user:change-this-password@127.0.0.1:3306/erp_mis_system?charset=utf8mb4

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

# Optional: set strong passwords to create active demo Manager and Staff logins.
# Keep these values private and run seed_demo.py against the production DATABASE_URL.
DEMO_MANAGER_PASSWORD=
DEMO_STAFF_PASSWORD=

SESSION_COOKIE_SECURE=true
APP_ENV=production
ALLOW_SQLITE_FALLBACK=false
TRUST_PROXY=false
PROXY_FIX_HOPS=1
